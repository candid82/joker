(def exit-code 0)

(defn clean
  [output]
  (let [output (if (nil? output) "" output)]
    (->> output
         (joker.string/split-lines)
         (remove #(joker.string/starts-with? % "  "))
         (remove #(= % ""))
         (joker.string/join "\n"))))

(defn test-flags
  [out description flags expected]
  (let [pwd (get (joker.os/env) "PWD")
        flag-parts (joker.string/split flags #"\s+")
        stdin? (some #(= "<" %) flag-parts)
        cmd (str pwd "/joker")
        output (if stdin?
                 (out (joker.os/sh "sh" "-c" (str cmd " " flags)))
                 (out (apply (partial joker.os/sh cmd) flag-parts)))
        output (if (string? output) (clean output) output)]
    (when-not (= output expected)
      (println "FAILED: testing" description "(" flags ")")
      (println "EXPECTED")
      (println expected)
      (println "ACTUAL")
      (println output)
      (println "")
      (var-set #'exit-code 1))))

(defn testing
  [out description & tests]
  (let [tests (partition 2 tests)]
    (doseq [[flags expected] tests]
      (test-flags out description flags expected))))

(testing :err "removed evaluator flag"
  "--no-vm"
  "Error: Unrecognized option '--no-vm'")

(testing :err "auto detect dialect from filename"
  "--lint tests/flags/input.clj"
  ""
  "--lint tests/flags/input-warning.clj"
  "tests/flags/input-warning.clj:1:7: Parse warning: unused binding: a")

(testing :err "specify joker dialect"
  "--lintjoker tests/flags/input.joke"
  ""

  "--lint --dialect joker tests/flags/input.joke"
  ""

  "--lintjoker tests/flags/input.clj"
  "tests/flags/input.clj:1:2: Parse error: Unable to resolve symbol: clojure.string/split"

  "--lint --dialect joker tests/flags/input.cljs"
  "tests/flags/input.cljs:1:7: Parse error: Unable to resolve symbol: js/console")

(testing :err "specify clj dialect"
  "--lintclj tests/flags/input.clj"
  ""

  "--lint --dialect clj tests/flags/input.clj"
  ""

  "--lintclj tests/flags/input.edn"
  "tests/flags/input.edn:1:17: Read warning: No reader function for tag foo/bar"

  "--lint --dialect clj tests/flags/input.cljs"
  "tests/flags/input.cljs:1:7: Parse error: Unable to resolve symbol: js/console")

(testing :err "specify cljs dialect"
  "--lintcljs tests/flags/input.cljs"
  ""

  "--lint --dialect cljs tests/flags/input.cljs"
  ""

  "--lintcljs tests/flags/input.edn"
  "tests/flags/input.edn:1:17: Read warning: No reader function for tag foo/bar"

  "--lintcljs tests/flags/input.clj"
  "tests/flags/input.clj:1:2: Parse error: Unable to resolve symbol: clojure.string/split")

(testing :err "reading from stdin"
  "--lint --dialect edn - < tests/flags/input.edn"
  ""

  "--lint --dialect clj - < tests/flags/input.edn"
  "<stdin>:1:17: Read warning: No reader function for tag foo/bar"

  "--lint --dialect clj - < tests/flags/input.clj"
  ""

  "--lint --dialect cljs - < tests/flags/input.clj"
  "<stdin>:1:2: Parse error: Unable to resolve symbol: clojure.string/split"

  "--lint --dialect cljs - < tests/flags/input.cljs"
  ""

  "--lint --dialect joker - < tests/flags/input.cljs"
  "<stdin>:1:7: Parse error: Unable to resolve symbol: js/console"

  "--lint --dialect joker - < tests/flags/input.joke"
  "")

(testing :err "working directory override"
  "--lint --dialect clj - < tests/flags/macro.clj"
  "<stdin>:4:11: Parse error: Unable to resolve symbol: something"

  "--lint --dialect clj --working-dir tests/flags/config - < tests/flags/macro.clj"
  "")

(testing :out "script args don't cause errors"
  "tests/flags/script-flags.joke -go-style-flag -otherflag"
  "[-go-style-flag -otherflag]"

  "tests/flags/script-flags.joke --unix-style-flag --otherflag"
  "[--unix-style-flag --otherflag]"

  "tests/flags/script-flags.joke --unix-style-flag-with-value foobar"
  "[--unix-style-flag-with-value foobar]"

  "tests/flags/script-flags.joke --unix-style-flag-with-value=foobar"
  "[--unix-style-flag-with-value=foobar]"

  "tests/flags/script-flags.joke --short-hand-flags -a -b -c"
  "[--short-hand-flags -a -b -c]"

  "tests/flags/script-flags.joke --short-hand-flags -abc"
  "[--short-hand-flags -abc]"

  "tests/flags/script-flags.joke -- something that is not a flag"
  "[-- something that is not a flag]")

(testing :err "negative numbers parsed correctly"
         "--hashmap-threshold -1 tests/flags/input.joke"
         "")

(testing :out "task runner functionality"
  "--task-file tests/flags/tasks.joke --list-tasks"
  "clean-all  Clean everything\ndefault    Run default task\nfail       Failing task\ngreet      Greet people\nhello      Say hello"

  "--task-file tests/flags/tasks.joke --tasks"
  "clean-all  Clean everything\ndefault    Run default task\nfail       Failing task\ngreet      Greet people\nhello      Say hello"

  "--task-file tests/flags/tasks.joke --task"
  "running default task"

  "--task-file tests/flags/tasks.joke --task hello"
  "hello from task"

  "--task-file tests/flags/tasks.joke --task greet Alice Bob"
  "greetings: Alice, Bob"

  "--task-file tests/flags/tasks.joke --task clean_all"
  "cleaning all"

  "--task-file tests/flags/tasks_no_ns.joke --list-tasks"
  "build    Build project\ndefault  Default task without namespace"

  "--task-file tests/flags/tasks_no_ns.joke --task build"
  "running build")

(testing :err "task runner error handling"
  "--task-file tests/flags/tasks.joke --task nonexistent"
  "Error: Task 'nonexistent' not found in tests/flags/tasks.joke"

  "--task-file nonexistent.joke --task foo"
  "Error: Tasks file not found: nonexistent.joke")

(testing :out "task file context"
  "--task-file tests/flags/tasks_context/tasks.joke --task file-context"
  "true"

  "--task-file tests/flags/tasks_context/tasks.joke --task delayed-require"
  "helper loaded")

(testing :exit "task exit codes"
  "--task-file tests/flags/tasks.joke --task fail"
  5

  "--task-file tests/flags/tasks_exit_codes.joke --task int-success"
  0

  "--task-file tests/flags/tasks_exit_codes.joke --task bigint-success"
  0

  "--task-file tests/flags/tasks_exit_codes.joke --task bigint-fail"
  5)

(testing #(vector (:exit %) (clean (:out %)) (clean (:err %)))
  "conflicting task modes are rejected before execution"
  "--lint --file tests/flags/input.joke --task-file tests/flags/tasks.joke --task hello"
  [18 "" "Error: Cannot combine --task and --lint."]

  "-e (println,:unexpected) --task-file tests/flags/tasks.joke --task hello"
  [19 "" "Error: Cannot combine --task and --eval/-e."]

  "--repl --task-file tests/flags/tasks.joke --task hello"
  [20 "" "Error: Cannot combine --task and --repl."]

  "--file tests/flags/input.joke --task-file tests/flags/tasks.joke --task hello"
  [21 "" "Error: Cannot combine --task and a <filename> argument."]

  "--lint --file tests/flags/input.joke --task-file tests/flags/tasks.joke --list-tasks"
  [18 "" "Error: Cannot combine --list-tasks and --lint."]

  "-e (println,:unexpected) --task-file tests/flags/tasks.joke --list-tasks"
  [19 "" "Error: Cannot combine --list-tasks and --eval/-e."]

  "--repl --task-file tests/flags/tasks.joke --list-tasks"
  [20 "" "Error: Cannot combine --list-tasks and --repl."]

  "--file tests/flags/input.joke --task-file tests/flags/tasks.joke --list-tasks"
  [21 "" "Error: Cannot combine --list-tasks and a <filename> argument."])

(joker.os/exit exit-code)
