(ns function-diagnostic-names)

(map [])
(conj [])
(defn original [x] x)
(original)
(def renamed-original original)
(renamed-original)
(let [renamed original] (renamed))
(let [local (fn [x] x) renamed local] (renamed))
(let [local ^{:note true} (fn [x] x)] (local))
(loop [local (fn [x] x)] (local))
(letfn [(local [x] x)] (local))
(def explicit (fn self-name [x] x))
(explicit)
(let [local (fn self-name [x] x)] (local))
((fn [x] x))

(defn typed [^String value] value)
(let [renamed typed] (renamed 42))
(def typed-alias typed)
(typed-alias 42)
(let [local (fn [^String value] value) renamed local] (renamed 42))
(let [local (fn self-name [^String value] value)] (local 42))

(defn ^String bad-return [] 42)

(defn multi ([x] x) ([x y z] x))
(multi 1 2)
(defn variadic [x y & xs] x)
(variadic 1)
(defn gap ([] nil) ([x y & xs] x))
(gap 1)
(get {})
